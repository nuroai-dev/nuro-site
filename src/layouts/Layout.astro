---
// Root layout: the <html> shell (SPEC §4 Meta) with self-hosted fonts, global CSS, metadata/OG
// and the motion runtime. Variable fonts: one woff2 per family per subset, picked via unicode-range.
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@/styles/globals.css";

// Above-the-fold latin font files, preloaded so the hero never swaps from the fallback font.
// Same files the @font-face rules reference, so Vite dedupes them to one asset.
import plexLatinHref from
  "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import interLatinHref from
  "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

import { getLang, canonicalUrl, hreflangUrls, SITE_URL } from "@/i18n/ui";

const DEFAULT_TITLE = "Nuro: Inclusive Education for Swedish Schools";
const DEFAULT_DESCRIPTION =
  "Nuro helps Swedish schools support neurodiverse students with ADHD, Autism, and Dyslexia. AI-powered lesson adaptation that meets Skollagen requirements.";

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  publishedTime?: string;
  author?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogType = "website",
  publishedTime,
  author,
  ogImage,
  ogImageAlt,
} = Astro.props;
const TITLE = title;
const DESCRIPTION = description;
// canonical, og:url and hreflang come from one helper so they match the sitemap exactly.
const CANONICAL = canonicalUrl(Astro.url.pathname);
const HREFLANG = hreflangUrls(Astro.url.pathname);

// Active language of this page.
const LANG = getLang(Astro.url);
// Share card follows the page's language, so a Swedish page shared on LinkedIn
// shows the Swedish card.
const OG_IMAGE =
  ogImage ??
  (LANG === "sv" ? `${SITE_URL}/og/pages/home-sv.png` : `${SITE_URL}/og.png`);
const OG_IMAGE_ALT =
  ogImageAlt ??
  (LANG === "sv"
    ? "Nuro. Hjälp skolor att sluta bryta mot lagen."
    : "Nuro. Let's help schools stop breaking the law.");
const OG_LOCALE = LANG === "sv" ? "sv_SE" : "en_US";
// Only advertise the alternate locale when this page actually exists in it.
const OG_LOCALE_ALT = HREFLANG.en && HREFLANG.sv ? (LANG === "sv" ? "en_US" : "sv_SE") : null;
// x-default is the English page, or the Swedish one when there is no English twin.
const X_DEFAULT = HREFLANG.en ?? HREFLANG.sv;

// Site-wide JSON-LD (Organization + WebSite + SoftwareApplication) so search and
// answer engines resolve Nuro as an entity.
const SOCIAL = [
  "https://www.linkedin.com/company/nuroaidev/",
  "https://www.instagram.com/nuroai.dev/",
];
const STRUCTURED_DATA = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: "Nuro",
      alternateName: "Nuro AI",
      url: SITE_URL,
      logo: `${SITE_URL}/logo.png`,
      description:
        "Nuro helps Swedish schools support neurodivergent students with ADHD, autism, and dyslexia through AI-powered lesson adaptation.",
      slogan: "The missing tool for neurodivergent students",
      knowsLanguage: ["en", "sv"],
      knowsAbout: [
        "Neurodiversity",
        "Special education",
        "ADHD",
        "Autism",
        "Dyslexia",
        "Inclusive education",
        "Skollagen",
      ],
      areaServed: { "@type": "Country", name: "Sweden" },
      founder: [
        { "@type": "Person", name: "Sandra Hilltomt", jobTitle: "Founder & CEO" },
        { "@type": "Person", name: "Victor Wallander", jobTitle: "Founder & CTO" },
        { "@type": "Person", name: "Jonathan Olsen", jobTitle: "Founding Designer" },
      ],
      sameAs: SOCIAL,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: SITE_URL,
      name: "Nuro",
      description: DEFAULT_DESCRIPTION,
      publisher: { "@id": `${SITE_URL}/#organization` },
      inLanguage: LANG,
    },
    {
      "@type": "SoftwareApplication",
      name: "Nuro",
      applicationCategory: "EducationalApplication",
      operatingSystem: "Web",
      url: SITE_URL,
      description:
        "An AI-powered platform that helps teachers see every student and give neurodivergent students the adapted support Skollagen entitles them to, catching those at risk before they fall through the cracks.",
      audience: {
        "@type": "EducationalAudience",
        educationalRole: ["teacher", "student", "parent"],
      },
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang={LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={CANONICAL} />
    {HREFLANG.en && <link rel="alternate" hreflang="en" href={HREFLANG.en} />}
    {HREFLANG.sv && <link rel="alternate" hreflang="sv" href={HREFLANG.sv} />}
    {X_DEFAULT && <link rel="alternate" hreflang="x-default" href={X_DEFAULT} />}
    <link rel="alternate" type="application/rss+xml" title={LANG === "sv" ? "Nuro Blogg" : "Nuro Blog"} href={LANG === "sv" ? `${SITE_URL}/sv/rss.xml` : `${SITE_URL}/rss.xml`} />

    {/* Preload the above-the-fold webfonts so the hero never swaps from the
        system fallback (which would reflow the H1 mid blur-in). */}
    <link
      rel="preload"
      href={plexLatinHref}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interLatinHref}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />

    <meta name="theme-color" content="#FAF7F2" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={OG_LOCALE} />
    {OG_LOCALE_ALT && <meta property="og:locale:alternate" content={OG_LOCALE_ALT} />}
    <meta property="og:url" content={CANONICAL} />
    <meta property="og:site_name" content="Nuro" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && author && <meta property="article:author" content={author} />}
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(STRUCTURED_DATA)}
    />

    {/* Runs before paint: marks JS as available so the reveal motion gates
        its hidden initial state on [data-js]. */}
    <script is:inline>
      document.documentElement.dataset.js = "1";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{LANG === "sv" ? "Hoppa till huvudinnehållet" : "Skip to main content"}</a>
    <slot />
    <script>
      import "@/scripts/motion";
    </script>
  </body>
</html>
