---
import Arrow from "@/components/site/Arrow.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import Reveal from "@/components/motion/Reveal.astro";
import BreadcrumbSchema from "@/components/seo/BreadcrumbSchema.astro";
import { copy } from "@/components/brand/about/i18n";
import { team } from "@/components/brand/about/team";
import founders from "@/components/brand/about/assets/founders-wide.webp?url";
import { getLang, localizePath } from "@/i18n/ui";
import "@/styles/about.css";
const lang = getLang(Astro.url), t = copy[lang].nuroAbout;
const path = (url:string) => localizePath(url,lang);
---
<SiteLayout title={t.pageTitle} description={t.description}>
  <BreadcrumbSchema name={lang === "sv" ? "Om Nuro" : "About Nuro"} />
  <main id="main-content" class="about-page" tabindex="-1">
    <section class="about-hero about-container" aria-labelledby="about-title">
      <Reveal eager><p class="about-eyebrow">{t.mission}</p></Reveal>
      <Reveal eager delay={0.06}><h1 id="about-title">{t.headline} <br/><span>{t.headlineEnd}</span></h1></Reveal>
      <Reveal eager delay={0.13}><p class="about-introduction">{t.introduction}</p></Reveal>
      <Reveal eager delay={0.2}><a class="about-text-link" href="#about-team-heading">{t.meet}<Arrow direction="down" /></a></Reveal>
    </section>
    <section class="about-team about-container" aria-labelledby="about-team-heading">
      <Reveal class="about-section-heading"><h2 id="about-team-heading" tabindex="-1">{t.teamTitle}</h2><p>{t.teamIntro}</p></Reveal>
      <div class="about-team-grid">
        {team.map((person,index) => <Reveal delay={(index%3)*0.07}><article class="about-person" data-person={person.id}>
          <img src={person.image} alt={person.name} width="500" height="500" loading="lazy" decoding="async" />
          <div class="about-person-caption"><h3>{person.name}</h3><p>{t.roles[person.id]}</p></div>
        </article></Reveal>)}
        <Reveal delay={0.14}><div class="about-careers"><p class="about-eyebrow">{t.growing}</p><h3>{t.growingTitle}</h3><p>{t.growingText}</p><a class="about-text-link" href={path("/career")}>{t.careers} <Arrow /></a></div></Reveal>
      </div>
    </section>
    <section class="about-story" aria-labelledby="about-story-heading">
      <div class="about-container about-story-grid">
        <Reveal class="about-founders"><figure><img src={founders} alt={t.foundersAlt} width="1600" height="900" loading="lazy"/><figcaption><span>{t.foundersCaption}</span><span>{t.foundersRole}</span></figcaption></figure></Reveal>
        <div class="about-story-copy"><Reveal><p class="about-eyebrow">{t.storyLabel}</p><h2 id="about-story-heading">{t.storyTitle}</h2></Reveal><Reveal delay={0.06}><p class="about-story-lead">{t.storyLead}</p></Reveal>{[t.storyOne,t.storyTwo,t.storyThree].map(text=><Reveal><p>{text}</p></Reveal>)}</div>
      </div>
      <Reveal class="about-container about-belief"><p class="about-eyebrow">{t.beliefLabel}</p><p>{t.belief}</p></Reveal>
    </section>
    <section class="about-invitation about-container"><Reveal><p class="about-eyebrow">{t.ctaLabel}</p><h2>{t.ctaTitle}</h2><p class="about-invitation-copy">{t.ctaText}</p><div class="about-invitation-actions"><a class="about-button" href={`${path("/")}?join=1`}>{t.join} <Arrow /></a><button type="button" class="about-text-link" data-contact-trigger>{t.contact} <Arrow /></button></div></Reveal></section>
  </main>
</SiteLayout>
