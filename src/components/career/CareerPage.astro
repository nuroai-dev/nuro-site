---
import Arrow from "@/components/site/Arrow.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import Reveal from "@/components/motion/Reveal.astro";
import BreadcrumbSchema from "@/components/seo/BreadcrumbSchema.astro";
import JobPostingSchema from "@/components/seo/JobPostingSchema.astro";
import { CAREER_ROLES } from "@/data/careers";
import { getLang,localizePath } from "@/i18n/ui";
import { team } from "@/components/brand/about/team";
import founders from "@/components/brand/about/assets/founders-wide.webp?url";
import "@/styles/editorial.css";
const lang=getLang(Astro.url);
const t=lang === "sv" ? {
 title:"Karriär | Nuro",description:"Hjälp oss skapa lärstöd som fungerar för fler. Lär känna teamet på Nuro och hör av dig.",
 label:"Karriär",heading:"Plats för",end:"ditt perspektiv.",intro:"Vi bygger en annan väg till lärande. Det börjar med människor som ser saker på olika sätt.",team:"Lär känna teamet",contact:"Presentera dig",
 mission:"Det vi bygger",story:"Fler sätt att tänka. Fler sätt att lära.",p1:"Vi är ett litet team i Sverige med ett gemensamt uppdrag: att göra anpassat lärstöd tillgängligt för elever som lär sig på olika sätt.",p2:"Det kräver teknik, omtanke och en vilja att lyssna. Vi vill träffa människor som bryr sig om utbildning, inkludering och att bygga något som gör skillnad.",
 roles:"Möjligheter",apply:"Sök tjänsten",open:"Spontanansökan",openTitle:"Inte rätt roll? Vi pratar gärna ändå.",openText:"Vill du bidra till Nuro på ett annat sätt vill vi gärna lära känna dig. Berätta vem du är och vad du skulle vilja bygga med oss.",rolesTitle:"Inget som passar just nu? Låt oss prata ändå.",rolesText:"Vi har inga lediga tjänster utlysta just nu. Men om du vill bidra till Nuro vill vi gärna lära känna dig. Berätta vem du är och vad du skulle vilja bygga med oss.",disciplines:["Teknik","Design","Pedagogik","Forskning","Gemenskap"],photo:"Sandra Hilltomt och Victor Wallander, medgrundare av Nuro",
} : {
 title:"Career | Nuro",description:"Help us build learning support that works for more minds. Meet the Nuro team and introduce yourself.",
 label:"Career",heading:"Room for",end:"your perspective.",intro:"We’re building a different way to learn. It starts with people who see things differently.",team:"Meet the team",contact:"Introduce yourself",
 mission:"What we’re building",story:"More ways to think. More ways to learn.",p1:"We’re a small team in Sweden with a shared purpose: making adapted learning support available to students who learn differently.",p2:"That takes technology, care, and a willingness to listen. We want to meet people who care about education, inclusion, and building something that makes a difference.",
 roles:"Opportunities",apply:"Apply now",open:"Open application",openTitle:"Not the right role? Let’s talk anyway.",openText:"If you’d like to help build Nuro in another way, we’d love to get to know you. Tell us who you are and what you’d like to build with us.",rolesTitle:"No perfect opening? Let’s talk anyway.",rolesText:"We don’t have any open positions posted right now. But if you’d like to help build Nuro, we’d love to get to know you. Tell us who you are and what you’d like to build with us.",disciplines:["Engineering","Design","Education","Research","Community"],photo:"Sandra Hilltomt and Victor Wallander, co-founders of Nuro",
};
const roles=CAREER_ROLES;
---
<SiteLayout title={t.title} description={t.description}>
 <BreadcrumbSchema name={t.label} />
 {roles.length > 0 && <JobPostingSchema roles={roles} />}
 <main id="main-content" tabindex="-1">
  <section class="site-hero site-container career-hero"><Reveal eager><p class="site-eyebrow">{t.label}</p></Reveal><Reveal eager delay={0.06}><h1 class="site-title">{t.heading} <br/><span>{t.end}</span></h1></Reveal><Reveal eager delay={0.13}><p class="site-intro">{t.intro}</p></Reveal><Reveal eager delay={0.2}><div class="career-people">{team.map(person=><img src={person.image} alt="" width="48" height="48"/>)}<a href={localizePath("/about#about-team-heading",lang)}>{t.team} <Arrow /></a></div></Reveal></section>
  {roles.length > 0 && <section class="site-container career-roles" aria-labelledby="career-roles-label"><Reveal><p class="site-eyebrow" id="career-roles-label">{t.roles}</p></Reveal>
   {roles.map(role=>{const r=role[lang];return <Reveal><article class="career-role" id={role.id}>
    <div class="career-role-head"><h2>{r.title}</h2><p class="career-role-meta">{r.meta.map(fact=><span>{fact}</span>)}</p><a class="site-button" href="mailto:hello@nuroai.dev" data-contact-trigger data-contact-topic="career">{t.apply} <Arrow /></a></div>
    <div class="career-role-body">{r.intro.map(text=><p>{text}</p>)}<p class="career-role-lead">{r.doLead}</p><ul>{r.doItems.map(item=><li>{item}</li>)}</ul><p class="career-role-lead">{r.youLead}</p><ul>{r.youItems.map(item=><li>{item}</li>)}</ul><p>{r.bonus}</p><p>{r.apply} <a class="career-role-mail" href="mailto:hello@nuroai.dev">hello@nuroai.dev</a>. {r.share}</p></div>
   </article></Reveal>})}
  </section>}
  <section class="site-container career-story"><Reveal><img src={founders} alt={t.photo} width="1600" height="900" loading="lazy"/></Reveal><div><Reveal><p class="site-eyebrow">{t.mission}</p><h2>{t.story}</h2></Reveal><Reveal delay={0.07}><p>{t.p1}</p></Reveal><Reveal delay={0.14}><p>{t.p2}</p></Reveal></div></section>
  <section class="site-container career-invite"><Reveal><p class="site-eyebrow">{roles.length > 0 ? t.open : t.roles}</p><h2>{roles.length > 0 ? t.openTitle : t.rolesTitle}</h2></Reveal><Reveal delay={0.1}><p>{roles.length > 0 ? t.openText : t.rolesText}</p><div class="career-disciplines">{t.disciplines.map(label=><span>{label}</span>)}</div><button type="button" class="site-button" data-contact-trigger data-contact-topic="career">{t.contact} <Arrow /></button></Reveal></section>
 </main>
</SiteLayout>
