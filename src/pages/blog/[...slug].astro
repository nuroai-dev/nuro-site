---
// Single blog post (/blog/<slug>): Markdown body, optional hero, and BlogPosting +
// BreadcrumbList JSON-LD, whose urls come from canonicalUrl().
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav/Nav.astro";
import Footer from "@/components/footer/Footer.astro";
import Reveal from "@/components/motion/Reveal.astro";
import RelatedPosts from "@/components/blog/RelatedPosts.astro";
import PostCta from "@/components/blog/PostCta.astro";
import styles from "@/components/blog/blog.module.css";
import { buildTagIndex, tagSlug, tagLabel } from "@/lib/blog-tags";
import { canonicalUrl, SITE_URL } from "@/i18n/ui";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Clickable tag chips: only tags that have their own topic-hub page (used by
// 2+ posts) qualify, so every chip links somewhere real.
const qualifying = new Set(
  buildTagIndex(await getCollection("blog", ({ data }) => !data.draft)).map(
    (g) => g.slug,
  ),
);
const tagSlugs = [...new Set(post.data.tags.map(tagSlug))].filter((s) =>
  qualifying.has(s),
);

const { heroImage, heroImageAlt, heroImageWidth, heroImageHeight } = post.data;
const hero = heroImage
  ? { src: heroImage, alt: heroImageAlt!, width: heroImageWidth!, height: heroImageHeight! }
  : null;

const url = canonicalUrl(Astro.url.pathname);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  inLanguage: "en-US",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { "@type": "Organization", name: post.data.author },
  publisher: { "@id": `${SITE_URL}/#organization` },
  mainEntityOfPage: url,
  image: [
    `${SITE_URL}/og/blog/${post.id}.png`,
    ...(hero ? [`${SITE_URL}${hero.src}`] : []),
  ],
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: canonicalUrl("/") },
    { "@type": "ListItem", position: 2, name: "Blog", item: canonicalUrl("/blog") },
    { "@type": "ListItem", position: 3, name: post.data.title, item: url },
  ],
};
---

<Layout title={`${post.data.title} | Nuro`} description={post.data.description} ogType="article" publishedTime={post.data.pubDate.toISOString()} author={post.data.author} ogImage={`${SITE_URL}/og/blog/${post.id}.png`} ogImageAlt={post.data.title}>
  <Nav />
  <main id="main-content" tabindex="-1">
    <section class={styles.section}>
      <div class={`${styles.container} ${styles.article}`}>
        <a class={styles.backLink} href="/blog">← Blog</a>
        <Reveal as="h1" eager class={styles.heading}>{post.data.title}</Reveal>
        <Reveal as="p" eager delay={0.06} class={styles.articleMeta}>
          {fmt(post.data.pubDate)} · {post.data.author}
        </Reveal>
        {tagSlugs.length > 0 && (
          <div class={styles.tags}>
            {tagSlugs.map((s) => (
              <a class={styles.tagChip} href={`/blog/tag/${s}`}>{tagLabel(s)}</a>
            ))}
          </div>
        )}
        {hero && (
          <img
            class={`${styles.heroImage} ${hero.height > hero.width ? styles.heroPortrait : ""}`}
            src={hero.src}
            alt={hero.alt}
            width={hero.width}
            height={hero.height}
            fetchpriority="high"
            decoding="async"
          />
        )}
        <article class={styles.prose}>
          <Content />
        </article>
      </div>
    </section>
    <PostCta />
    <RelatedPosts post={post} collection="blog" />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
</Layout>
