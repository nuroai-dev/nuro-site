# Contact form email delivery (src/lib/contact/save-contact-entry.ts).
# Set these on the deploy platform's environment.

# Resend API key — required for the contact form to actually send.
# Without it, contact submissions are stored but are not emailed.
RESEND_API_KEY=

# Recipient + sender. The CONTACT_FROM domain must be verified in Resend.
# Defaults: hello@nuroai.dev / "Nuro <hello@nuroai.dev>"
CONTACT_TO=hello@nuroai.dev
CONTACT_FROM=Nuro <hello@nuroai.dev>

# Durable form storage (defaults to the existing /data deployment volume).
# Set local directories when developing, e.g. /tmp/nuro-site-local-data.
WAITLIST_DIR=/data
CONTACT_DIR=/data

# Protect administrative CSV exports with long random values. Never expose these to the browser.
WAITLIST_EXPORT_TOKEN=
CONTACT_EXPORT_TOKEN=
